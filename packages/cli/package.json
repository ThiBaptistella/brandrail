{
  "name": "brandrail",
  "version": "0.2.0",
  "description": "Keep AI-generated UI on-brand: checks code and live pages against your design system, and wires your Brand Kit into Claude Code, Cursor, Copilot and Codex.",
  "keywords": [
    "design-system",
    "design-tokens",
    "lint",
    "ai",
    "mcp",
    "claude",
    "cursor",
    "copilot",
    "tailwind",
    "brand"
  ],
  "homepage": "https://web-phi-nine-77.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThiBaptistella/brandrail.git",
    "directory": "packages/cli"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "brandrail": "dist/brandrail.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/brandrail.mjs --external:playwright --external:playwright-core --banner:js='#!/usr/bin/env node' && chmod +x dist/brandrail.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@brandrail/engine": "workspace:*",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
